# MongoDB Atlas (скопіюй у .env і підстав пароль)
MONGODB_URI=mongodb+srv://userHome:<db_password>@cluster0.ehywaos.mongodb.net/
MONGODB_PASSWORD=<db_password>
MONGODB_DB=must_pv18
MONGODB_INTERVAL_SEC=600

# Ванна ESP32 + DHT11 (POST /api/bathroom/ingest) — обов'язково для ESP32
BATHROOM_INGEST_TOKEN=зміни_на_довгий_секрет
BATHROOM_STALE_SEC=120

# Домашній огляд /home/: ванна + провітрювання (0 = вимкнено, 1 = увімкнено)
HOME_INCLUDE_BATHROOM=0

# Telegram (@BotFather → token; /start боту → chat id, або див. відповідь бота)
TELEGRAM_BOT_TOKEN=
# один id або кілька через кому: 111111111,222222222
TELEGRAM_CHAT_ID=
# TELEGRAM_INTERVAL_SEC=45
# TELEGRAM_GRID_V_MIN=180
# TELEGRAM_CHARGE_W_MIN=80
# TELEGRAM_DEBOUNCE_SAMPLES=3
