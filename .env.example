# MongoDB Atlas (скопіюй у .env і підстав пароль)
MONGODB_URI=mongodb+srv://userHome:<db_password>@cluster0.ehywaos.mongodb.net/
MONGODB_PASSWORD=<db_password>
MONGODB_DB=must_pv18
MONGODB_INTERVAL_SEC=600

# Ванна ESP32 + DHT11 (POST /api/bathroom/ingest) — обов'язково для ESP32
BATHROOM_INGEST_TOKEN=зміни_на_довгий_секрет
BATHROOM_STALE_SEC=120
